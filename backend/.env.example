# Backend Environment Configuration

# ============================================
# Server Configuration
# ============================================

PORT=5000
NODE_ENV=development

# HTTPS Configuration (Optional - for production-like testing)
# Set to 'true' to enable HTTPS on the backend server
# Requires certificates in backend/.cert/ directory
# Use the same certificates from frontend setup: cp -r frontend/.cert backend/
# ENABLE_HTTPS=false

# ============================================
# Database Configuration (Cloud - Neon)
# ============================================

PGHOST=your-neon-host.neon.tech
PGDATABASE=your-database
PGUSER=your-user
PGPASSWORD=your-password
PGSSLMODE=require
PGCHANNELBINDING=require

DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_NAME=your-database
DB_USER=your-user
DB_PASSWORD=your-password
DB_SSL=require
DB_CHANNEL_BINDING=require

# ============================================
# Local PostgreSQL (Backup/Fallback)
# ============================================

DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=5432
DB_NAME_LOCAL=matatuconnect
DB_USER_LOCAL=postgres
DB_PASSWORD_LOCAL=your-local-password
DB_SSL_LOCAL=false

# ============================================
# JWT Configuration
# ============================================

JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRE=7d

# ============================================
# M-Pesa Configuration (Daraja API)
# ============================================

# Sandbox
MPESA_API_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_BUSINESS_CODE=174379
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback

# Production
# MPESA_API_URL=https://api.safaricom.co.ke
# MPESA_BUSINESS_CODE=your-business-code
# MPESA_SHORTCODE=your-shortcode

# ============================================
# WhatsApp Configuration (Twilio)
# ============================================

TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_WEBHOOK_TOKEN=your-webhook-token
WHATSAPP_TEST_SECRET=your-test-secret

# ============================================
# CORS Configuration
# ============================================

# Comma-separated list of allowed origins
# Use '*' for development (auto-allows private network IPs)
# For production, specify exact domains
CORS_ORIGIN=*

# Production example:
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Development HTTPS Notes
# ============================================

# To enable HTTPS on the backend:
# 1. Generate certificates in frontend: cd frontend && npm run setup:https
# 2. Copy certs to backend: cp -r frontend/.cert backend/
# 3. Set ENABLE_HTTPS=true in this file
# 4. Restart the backend server
#
# This is optional - normally the frontend Vite proxy handles
# HTTPS → HTTP translation, so the backend can stay on HTTP.
#
# Only use backend HTTPS for:
# - Production-like testing
# - Direct backend access from mobile devices
# - Testing SSL/TLS features
