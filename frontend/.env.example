# Frontend Environment Configuration

# ============================================
# HTTPS Configuration (Development)
# ============================================

# Enable HTTPS for local development
# Set to 'true' to force HTTPS, 'false' to force HTTP
# If not set, HTTPS is auto-enabled when certificates exist in .cert/
# VITE_DEV_HTTPS=true

# To generate certificates, run: npm run setup:https
# Then restart the dev server: npm run dev

# ============================================
# API Configuration
# ============================================

# Backend API URL
# Leave empty to use Vite proxy (recommended for development)
# This avoids mixed content issues when using HTTPS
VITE_API_URL=

# For production or custom backend:
# VITE_API_URL=http://localhost:5000
# VITE_API_URL=https://api.example.com

# ============================================
# Development Tips
# ============================================

# Run with HTTPS explicitly:
#   npm run dev:https

# Run with HTTP explicitly:
#   npm run dev:http

# Default behavior (auto-detect):
#   npm run dev

# ============================================
# How the Proxy Works
# ============================================

# When VITE_API_URL is empty:
# - Frontend makes requests to /api, /uploads, /socket.io
# - Vite proxy forwards these to http://localhost:5000
# - Browser only sees HTTPS requests (no mixed content warnings)
# - Backend can stay on HTTP for simpler development

# When VITE_API_URL is set:
# - Frontend makes direct requests to the specified URL
# - Useful for production or remote backend testing
# - If frontend uses HTTPS, backend should too (to avoid mixed content)
